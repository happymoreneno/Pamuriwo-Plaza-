<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pamuriwo Plaza</title><style>body{font:16px system-ui;background:#f4f7f4;color:#173323;margin:0}header{background:#17683d;color:white;padding:18px}main{max-width:850px;margin:auto;padding:15px}nav{display:flex;flex-wrap:wrap;gap:6px}button{background:#17683d;color:white;border:0;border-radius:8px;padding:11px;cursor:pointer}nav button{background:#e2eee5;color:#173323}.card{background:white;padding:15px;border-radius:12px;margin:12px 0;box-shadow:0 1px 5px #ddd}input,select{box-sizing:border-box;padding:11px;border:1px solid #bbb;border-radius:7px;width:100%;margin:5px 0 12px}label{display:block}table{width:100%;border-collapse:collapse;font-size:14px}td,th{border-bottom:1px solid #ddd;text-align:left;padding:8px} .scroll{overflow:auto}.muted{color:#666}.danger{background:#b33232}</style></head><body><header><h2>🥬 Pamuriwo Plaza</h2><div>Business Manager · USD</div><small id="status">Connecting…</small></header><main><section id="login" class="card"><h3>Private sign in</h3><p>Use an account enabled in Firebase Authentication.</p><label>Email<input id="email" type="email" autocomplete="username"></label><label>Password<input id="password" type="password" autocomplete="current-password"></label><button id="signin">Sign in</button><p id="error" class="muted"></p></section><section id="app" hidden><nav id="tabs"></nav><div id="content"></div><button id="signout" class="danger">Sign out</button></section></main><script type="module">
import {initializeApp} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js';
import {getAuth,signInWithEmailAndPassword,onAuthStateChanged,signOut} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js';
import {getFirestore,collection,addDoc,onSnapshot,deleteDoc,doc,serverTimestamp} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js';
const firebaseConfig={apiKey:'AIzaSyAg65V__FADaK6jUrzvJr2XX_TTCp3Z9PA',authDomain:'pamuriwo-plaza.firebaseapp.com',projectId:'pamuriwo-plaza',storageBucket:'pamuriwo-plaza.firebasestorage.app',messagingSenderId:'143853029279',appId:'1:143853029279:web:72cb7fe60047474f15dfaa',measurementId:'G-BB69E03CBM'};
const fb=initializeApp(firebaseConfig),auth=getAuth(fb),db=getFirestore(fb),$=id=>document.getElementById(id);let data={stock:[],sales:[],expenses:[],debtors:[]},unsubs=[],tab='Dashboard';const money=n=>'$'+Number(n||0).toFixed(2),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
$('signin').onclick=async()=>{try{$('error').textContent='';await signInWithEmailAndPassword(auth,$('email').value.trim(),$('password').value)}catch(e){$('error').textContent=e.message}};$('signout').onclick=()=>signOut(auth);
onAuthStateChanged(auth,user=>{unsubs.forEach(f=>f());unsubs=[];$('login').hidden=!!user;$('app').hidden=!user;$('status').textContent=user?'Signed in · Cloud sync':'Sign in to sync';if(user){for(const name of Object.keys(data)){unsubs.push(onSnapshot(collection(db,'pamuriwo_shared', 'business',name),s=>{data[name]=s.docs.map(d=>({id:d.id,...d.data()}));render()},e=>{$('status').textContent='Sync error: '+e.message}))}render()}});
const tabs=['Dashboard','Stock','Sales','Expenses','Debtors','Backup'];$('tabs').innerHTML=tabs.map(t=>`<button data-tab="${t}">${t}</button>`).join('');$('tabs').onclick=e=>{let t=e.target.dataset.tab;if(t){tab=t;render()}};
function form(fields,kind){return `<form id="entry"><h3>Add ${kind.slice(0,-1)}</h3>${fields.map(([key,type,label])=>`<label>${label}<input name="${key}" type="${type}" ${type==='number'?'step="0.01" min="0"':''} required></label>`).join('')}<button>Save to cloud</button></form>`}
function table(kind,cols){return `<div class="scroll"><table><thead><tr>${cols.map(c=>`<th>${c[1]}</th>`).join('')}<th></th></tr></thead><tbody>${data[kind].map(r=>`<tr>${cols.map(c=>`<td>${esc(r[c[0]])}</td>`).join('')}<td><button class="danger" data-delete="${esc(r.id)}" data-kind="${kind}">Delete</button></td></tr>`).join('')}</tbody></table></div>`}
function render(){let html='';if(tab==='Dashboard'){let sales=data.sales.reduce((s,x)=>s+Number(x.qty)*Number(x.price),0),cost=data.sales.reduce((s,x)=>s+Number(x.qty)*Number(x.cost),0),expenses=data.expenses.reduce((s,x)=>s+Number(x.amount),0),debt=data.debtors.reduce((s,x)=>s+Number(x.amount),0),stock=data.stock.reduce((s,x)=>s+Number(x.qty)*Number(x.cost),0);html=`<h2>Business overview</h2>${[['Sales revenue',sales],['Gross profit',sales-cost],['Expenses',expenses],['Net profit estimate',sales-cost-expenses],['Debtors balance',debt],['Stock at cost',stock]].map(x=>`<div class="card"><b>${x[0]}</b><h2>${money(x[1])}</h2></div>`).join('')}<div class="card"><h3>Low stock alerts</h3>${data.stock.filter(x=>Number(x.qty)<=Number(x.low)).map(x=>`<p>${esc(x.name)}: ${esc(x.qty)} left</p>`).join('')||'No low-stock items.'}</div><p class="muted">Profit is estimated from recorded sales and costs. Update stock quantities manually when making sales.</p>`}
if(tab==='Stock')html=`<div class="card">${form([['name','text','Product'],['qty','number','Quantity in stock'],['cost','number','Cost per unit (USD)'],['price','number','Selling price per unit (USD)'],['low','number','Low stock alert quantity']],'stock')}</div><div class="card">${table('stock',[['name','Product'],['qty','Qty'],['cost','Unit cost'],['price','Price']])}</div>`;
if(tab==='Sales')html=`<div class="card">${form([['name','text','Product'],['qty','number','Quantity sold'],['price','number','Selling price per unit (USD)'],['cost','number','Cost per unit (USD)']],'sales')}</div><div class="card">${table('sales',[['name','Product'],['qty','Qty'],['price','Unit price'],['cost','Unit cost']])}</div>`;
if(tab==='Expenses')html=`<div class="card">${form([['name','text','Expense description'],['amount','number','Amount (USD)']],'expenses')}</div><div class="card">${table('expenses',[['name','Description'],['amount','Amount']])}</div>`;
if(tab==='Debtors')html=`<div class="card">${form([['name','text','Customer name'],['amount','number','Outstanding amount (USD)'],['note','text','Notes']],'debtors')}</div><div class="card">${table('debtors',[['name','Customer'],['amount','Balance'],['note','Notes']])}</div>`;
if(tab==='Backup')html='<div class="card"><h3>Export records</h3><p>Download a JSON backup of the records currently synchronized on this device.</p><button id="export">Download backup</button></div>';
$('content').innerHTML=html;const f=$('entry');if(f)f.onsubmit=async e=>{e.preventDefault();let kind=tab.toLowerCase(),record=Object.fromEntries(new FormData(f));for(let [k,v] of Object.entries(record))if(['qty','cost','price','low','amount'].includes(k))record[k]=Number(v);try{await addDoc(collection(db,'pamuriwo_shared','business',kind),{...record,createdAt:serverTimestamp()});f.reset()}catch(e){alert('Could not save: '+e.message)}};
$('content').onclick=async e=>{let b=e.target.closest('[data-delete]');if(b&&confirm('Delete this record from both phones?')){try{await deleteDoc(doc(db,'pamuriwo_shared','business',b.dataset.kind,b.dataset.delete))}catch(e){alert(e.message)}}if(e.target.id==='export'){let blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='pamuriwo-backup.json';a.click();URL.revokeObjectURL(a.href)}}}
</script></body></html>
